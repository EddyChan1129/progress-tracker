// 使用 Firestore Security Rules version 2 語法。
rules_version = '2';

// 以下規則只套用到 Cloud Firestore。
service cloud.firestore {
  // {database} 代表任何 Firestore database ID，例如目前使用嘅 (default)。
  match /databases/{database}/documents {
    // 檢查使用者已登入，而且登入 UID 同 URL 路徑入面嘅 userId 相同。
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 檢查準備新增嘅 Category 欄位、型別同內容。
    function isValidCategory(userId) {
      let data = request.resource.data;

      return data.keys().hasAll(['userId', 'name', 'createdAt'])
        && data.keys().hasOnly(['userId', 'name', 'icon', 'createdAt'])
        && data.userId is string
        && data.userId == userId
        && data.name is string
        && data.name == data.name.trim()
        && data.name.size() > 0
        && data.name.size() <= 50
        && data.get('icon', '') is string
        && data.get('icon', '') == data.get('icon', '').trim()
        && data.get('icon', '').size() <= 10
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // 檢查 Learning Entry 欄位，並確認所選分類存在於本人路徑。
    function isValidLearningEntry(userId) {
      let data = request.resource.data;

      return data.keys().hasAll([
          'userId',
          'title',
          'content',
          'categoryId',
          'images',
          'learnedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'title',
          'content',
          'categoryId',
          'images',
          'learnedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.title is string
        && data.title == data.title.trim()
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.content is string
        && data.content.trim().size() > 0
        && data.categoryId is string
        && data.categoryId.size() > 0
        && data.images is list
        && data.images.size() <= 5
        && data.learnedAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/users/$(userId)/categories/$(data.categoryId));
    }

    // 新增同更新共用：驗證更新後嘅大目標欄位、日期及本人分類。
    function isValidGoal(userId) {
      let data = request.resource.data;

      return data.keys().hasAll([
          'userId', 'title', 'categoryId', 'status', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.title is string && data.title == data.title.trim()
        && data.title.size() > 0 && data.title.size() <= 100
        && data.get('description', '') is string
        && data.get('description', '') == data.get('description', '').trim()
        && data.get('description', '').size() <= 2000
        && data.categoryId is string && data.categoryId.size() > 0
        && data.categoryId == data.categoryId.trim()
        && data.categoryId.matches('^[^/]+$')
        && data.categoryId != '.' && data.categoryId != '..'
        && exists(/databases/$(database)/documents/users/$(userId)/categories/$(data.categoryId))
        && get(/databases/$(database)/documents/users/$(userId)/categories/$(data.categoryId)).data.userId == userId
        // 日期可以省略；有傳入就必須係 Timestamp，唔接受 null／字串。
        && (!('startDate' in data) || data.startDate is timestamp)
        && (!('targetDate' in data) || data.targetDate is timestamp)
        // 只有兩個日期都存在時，先檢查先後順序。
        && (!('startDate' in data) || !('targetDate' in data) || data.targetDate >= data.startDate)
        && data.status in ['not_started', 'in_progress', 'completed', 'paused']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    // 新增只准新版欄位；初始狀態及時間由 service／server 提供。
    function isValidNewGoal(userId) {
      let data = request.resource.data;
      return isValidGoal(userId)
        && data.keys().hasOnly([
          'userId', 'title', 'description', 'categoryId',
          'startDate', 'targetDate', 'status', 'createdAt', 'updatedAt'
        ])
        && data.status == 'not_started'
        && data.createdAt == request.time && data.updatedAt == request.time;
    }

    // 子目標唔可以懸空；parent 路徑同欄位擁有者都要正確。
    function hasOwnGoal(userId, goalId) {
      return exists(/databases/$(database)/documents/users/$(userId)/goals/$(goalId))
        && get(/databases/$(database)/documents/users/$(userId)/goals/$(goalId)).data.userId == userId;
    }

    // getAfter 睇同一個 batch 完成後嘅 parent，容許大／細目標一齊新增。
    // Parent 唔存在或擁有者唔正確時，細目標仍然會被拒絕。
    function hasOwnGoalAfter(userId, goalId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)/goals/$(goalId)).data.userId == userId;
    }

    function isValidNewSubGoal(userId, goalId) {
      let data = request.resource.data;
      let common = ['userId', 'goalId', 'title', 'kind', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(common)
        && data.userId == userId && data.goalId == goalId
        && data.title is string && data.title == data.title.trim()
        && data.title.size() > 0 && data.title.size() <= 100
        && data.get('description', '') is string
        && data.get('description', '') == data.get('description', '').trim()
        && data.get('description', '').size() <= 2000
        && data.createdAt is timestamp && data.createdAt == request.time
        && data.updatedAt is timestamp && data.updatedAt == request.time
        // 兩個分支各自限制必需／允許欄位，唔可以混用。
        && ((data.kind == 'checklist'
            && data.keys().hasAll(['isCompleted'])
            && data.keys().hasOnly(common.concat(['description', 'isCompleted']))
            && data.isCompleted is bool && !data.isCompleted)
          || (data.kind == 'count'
            && data.keys().hasAll(['targetValue', 'currentValue', 'unit'])
            && data.keys().hasOnly(common.concat(['description', 'targetValue', 'currentValue', 'unit']))
            && data.targetValue is number && data.targetValue > 0
            // 有限數相減係 0；Infinity 相減係 NaN，唔會通過。
            && data.targetValue - data.targetValue == 0
            && data.currentValue is number && data.currentValue == 0
            && data.unit is string && data.unit == data.unit.trim()
            && data.unit.size() > 0 && data.unit.size() <= 20));
    }

    function isValidSubGoalUpdate(userId, goalId) {
      let data = request.resource.data;
      let old = resource.data;
      let changed = data.diff(old).affectedKeys();
      return old.userId == userId && old.goalId == goalId
        // 只准改文字／計量定義；身份、類型、進度及建立時間原封保留。
        && changed.hasOnly(['title', 'description', 'targetValue', 'unit', 'updatedAt'])
        && data.title is string && data.title == data.title.trim()
        && data.title.size() > 0 && data.title.size() <= 100
        && data.get('description', '') is string
        && data.get('description', '') == data.get('description', '').trim()
        && data.get('description', '').size() <= 2000
        && data.updatedAt == request.time
        && ((old.kind == 'checklist' && !changed.hasAny(['targetValue', 'unit']))
          || (old.kind == 'count'
            && data.targetValue is number && data.targetValue > 0
            && data.targetValue - data.targetValue == 0
            && data.unit is string && data.unit == data.unit.trim()
            && data.unit.size() > 0 && data.unit.size() <= 20
            && (old.currentValue == 0 || !changed.hasAny(['targetValue', 'unit']))));
    }

    match /users/{userId}/categories/{categoryId} {
      // 本人可以讀取自己路徑入面嘅分類。
      allow read: if isOwner(userId);

      // 本人只可以新增通過上面資料檢查嘅分類。
      allow create: if isOwner(userId) && isValidCategory(userId);
    }

    match /users/{userId}/learningEntries/{entryId} {
      // 本人可以讀自己路徑入面嘅記錄。
      allow read: if isOwner(userId);

      // 新增時，建立及更新時間都必須由 Firestore server 產生。
      allow create: if isOwner(userId)
        && isValidLearningEntry(userId)
        && request.resource.data.images.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // 更新時不可轉移擁有者或改寫原本建立時間。
      allow update: if isOwner(userId)
        && isValidLearningEntry(userId)
        // Browser 只可保留 server 已驗證嘅圖片，唔可以增刪／改 URL。
        && request.resource.data.images == resource.data.images
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // 目前只刪除冇圖片嘅本人記錄；有圖片時需經之後嘅資產清理流程。
      allow delete: if isOwner(userId) && resource.data.images.size() == 0;
    }

    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidNewGoal(userId);
      allow update: if isOwner(userId) && resource.data.userId == userId
        && isValidGoal(userId)
        // affectedKeys 包括新增、修改及刪除嘅欄位；只准改以下幾個。
        // 因此 userId、createdAt、status 同舊計量欄位一律保留原值。
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'categoryId', 'startDate', 'targetDate', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      // 大目標 delete／進度歷史仍未開放。
      match /subGoals/{subGoalId} {
        allow read: if isOwner(userId) && hasOwnGoal(userId, goalId);
        allow create: if isOwner(userId) && hasOwnGoalAfter(userId, goalId)
          && isValidNewSubGoal(userId, goalId);
        allow update: if isOwner(userId) && hasOwnGoal(userId, goalId)
          && isValidSubGoalUpdate(userId, goalId);
        // 刪除同進度歷史留到之後嘅 task。
      }
    }

    // {document=**} 代表 database 入面任何深度、任何路徑嘅 document。
    // 例如：users/alice/learningEntries/entry-1。
    match /{document=**} {
      // false 代表條件永遠唔成立，所以所有 read 同 write 都會被拒絕。
      // 之後每完成一個 feature，先為嗰個指定路徑加入較精確嘅 allow 規則。
      allow read, write: if false;
    }
  }
}
