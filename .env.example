# Firebase Web App config. Copy these values from Firebase Console into .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary credentials. API secret must stay on the server.
# Find these in Cloudinary Console Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Console > Project settings > Service accounts > Generate new private key.
# Copy client_email and private_key from the JSON into .env.local (never commit the JSON).
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""
